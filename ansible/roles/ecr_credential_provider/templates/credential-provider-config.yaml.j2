# {{ ansible_managed }}
# El kubelet ejecuta el plugin antes de descargar una imagen que coincida con
# matchImages; el plugin usa el rol IAM de la instancia (IMDSv2) para pedir el token.
apiVersion: kubelet.config.k8s.io/v1
kind: CredentialProviderConfig
providers:
  - name: ecr-credential-provider
    apiVersion: credentialprovider.kubelet.k8s.io/v1
    matchImages:
{% for pattern in ecr_credential_provider_match_images %}
      - "{{ pattern }}"
{% endfor %}
    defaultCacheDuration: "{{ ecr_credential_provider_cache_duration }}"
    env:
      - name: AWS_REGION
        value: "{{ aws_region }}"
