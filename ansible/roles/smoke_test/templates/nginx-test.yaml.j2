# {{ ansible_managed }}  (cluster.md 4.2 / 4.3)
apiVersion: apps/v1
kind: Deployment
metadata:
  name: {{ smoke_test_name }}
spec:
  replicas: {{ smoke_test_replicas }}
  selector:
    matchLabels:
      app: {{ smoke_test_name }}
  template:
    metadata:
      labels:
        app: {{ smoke_test_name }}
    spec:
      nodeSelector:
        kubernetes.io/hostname: {{ smoke_test_node }}.{{ dns_domain }}
      containers:
        - name: nginx
          image: {{ smoke_test_image }}
          ports:
            - containerPort: 80
---
apiVersion: v1
kind: Service
metadata:
  name: {{ smoke_test_name }}
spec:
  type: NodePort
  selector:
    app: {{ smoke_test_name }}
  ports:
    - port: 80
      targetPort: 80
      nodePort: {{ smoke_test_node_port }}
